# ---------------------------------------------------------------------------
# Mosaic India — your private keys
#
# start.py copies this file to ".env" for you the first time it runs.
# Paste your keys into ".env" (NOT into this file). ".env" never leaves your
# computer and is never uploaded to GitHub.
#
# None of these are needed yet. You will be told when each one is needed.
# Leave a line empty if you don't have that key — the app will tell you
# what is missing instead of crashing.
# ---------------------------------------------------------------------------

# --- Angel One SmartAPI (live prices, optional — needed from M1) ------------
# Free with an Angel One trading account. Without it, prices are "delayed".
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PIN=
# The secret shown when you set up the authenticator app (not the 6-digit code)
ANGEL_ONE_TOTP_SECRET=

# --- Groq (AI, free tier — needed from M3) ----------------------------------
GROQ_API_KEY=

# --- Google Gemini (AI, free tier — needed from M3) -------------------------
GEMINI_API_KEY=

# --- Telegram alerts (optional — needed from M6) ----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
